[user]
	name = {{ .name }}
	email = {{ .email }}

[alias]
  plog = log --graph --all --oneline --decorate
[core]
	excludesfile = ~/.gitignore_global
	filemode = false
	eol = lf
	autocrlf = input
	hooksPath = ~/.config/git/hooks
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[color]
	ui = true
[init]
	defaultBranch = main
