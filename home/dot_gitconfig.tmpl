[user]
	name = {{ .name }}
	email = {{ .email }}

[alias]
  plog = log --graph --all --oneline --decorate
[core]
	excludesfile = ~/.gitignore_global
	filemode = false
	eol = lf
	autocrlf = input
{{- if ne .chezmoi.os "windows" }}
	hooksPath = ~/.config/git/hooks
{{- end }}
[color]
	ui = true
[init]
	defaultBranch = main
