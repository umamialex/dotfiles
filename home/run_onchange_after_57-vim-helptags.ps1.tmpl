{{- if eq .chezmoi.os "windows" -}}
# vim plugins hash: {{ .vim_plugins | toJson | sha256sum }}
$ErrorActionPreference = 'Stop'

# Vim's installer records the path of gvim.exe under HKCU (per-user install) or HKLM (all users).
# PATH is no use here: winget changes it after this session started, and adding to it is optional.
$vim = $null
foreach ($key in 'HKCU:\Software\Vim\Gvim', 'HKLM:\Software\Vim\Gvim', 'HKLM:\Software\WOW6432Node\Vim\Gvim') {
  $gvim = (Get-ItemProperty $key -ErrorAction SilentlyContinue).path
  if ($gvim -and (Test-Path (Join-Path (Split-Path $gvim) 'vim.exe'))) {
    $vim = Join-Path (Split-Path $gvim) 'vim.exe'
    break
  }
}
if (-not $vim) { $vim = (Get-Command vim -ErrorAction SilentlyContinue).Source }
if (-not $vim) { throw 'vim.exe not found: the Vim installer did not register itself' }

# generate help tags for the plugins chezmoi installed as native packages
& $vim -es -u NONE -N -c 'packloadall' -c 'helptags ALL' -c 'qa!'
if ($LASTEXITCODE -ne 0) { throw "vim exited with code $LASTEXITCODE" }
{{- end }}
