{{- $work := and (hasKey . "work") .work -}}
{{- if and (eq .chezmoi.os "windows") (not $work) -}}
#Requires -RunAsAdministrator
# startup list hash: {{ .packages.startup_disable | toJson | sha256sum }}
$ErrorActionPreference = 'Stop'

$runEntries = @('{{ .packages.startup_disable.run | join "','" }}')
$machineEntries = @('{{ .packages.startup_disable.run_machine | join "','" }}')
$folderEntries = @('{{ .packages.startup_disable.startup_folder | join "','" }}')

$explorer = 'Software\Microsoft\Windows\CurrentVersion\Explorer\StartupApproved'

# Same format Task Manager writes: first byte 3 = disabled, then the time it was disabled.
function Disable-StartupEntry($key, $name) {
  if (-not (Test-Path $key)) { New-Item -Path $key | Out-Null }
  $value = [byte[]](3, 0, 0, 0) + [BitConverter]::GetBytes([DateTime]::UtcNow.ToFileTimeUtc())
  Set-ItemProperty -Path $key -Name $name -Value $value -Type Binary
  Write-Host "Disabled startup entry: $name"
}

# Only touches entries that exist on this machine, so a missing app is not an error.
function Disable-RunEntries($runKey, $approvedKey, $patterns) {
  $present = if (Test-Path $runKey) { (Get-Item $runKey).Property } else { @() }
  foreach ($pattern in $patterns) {
    foreach ($name in @($present | Where-Object { $_ -like $pattern })) {
      Disable-StartupEntry $approvedKey $name
    }
  }
}

Disable-RunEntries 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Run' "HKCU:\$explorer\Run" $runEntries

# HKLM Run has a 64-bit and a 32-bit key, and each has its own StartupApproved key
Disable-RunEntries 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Run' "HKLM:\$explorer\Run" $machineEntries
Disable-RunEntries 'HKLM:\Software\WOW6432Node\Microsoft\Windows\CurrentVersion\Run' "HKLM:\$explorer\Run32" $machineEntries

$folders = @(
  @{ Path = Join-Path $env:ProgramData 'Microsoft\Windows\Start Menu\Programs\StartUp'; Key = "HKLM:\$explorer\StartupFolder" },
  @{ Path = [Environment]::GetFolderPath('Startup'); Key = "HKCU:\$explorer\StartupFolder" }
)
foreach ($folder in $folders) {
  foreach ($name in $folderEntries) {
    if (Test-Path (Join-Path $folder.Path $name)) { Disable-StartupEntry $folder.Key $name }
  }
}
{{- end }}
