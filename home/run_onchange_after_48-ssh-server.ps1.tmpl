{{- $server := and (hasKey . "server") .server -}}
{{- $key := "" -}}
{{- if hasKey . "ssh_public_key" -}}
{{-   $key = .ssh_public_key -}}
{{- end -}}
{{- if and (eq .chezmoi.os "windows") $server -}}
#Requires -RunAsAdministrator
# ssh_public_key sha256: {{ $key | sha256sum }}
$ErrorActionPreference = 'Stop'

# Home server only: installs the OpenSSH server, starts it at boot, opens port 22 and lets the
# public key from the ssh_public_key prompt log in. Administrators' keys live in
# administrators_authorized_keys, not in ~/.ssh/authorized_keys, and sshd ignores that file unless
# only SYSTEM and Administrators can access it.
$capability = 'OpenSSH.Server~~~~0.0.1.0'
$state = (Get-WindowsCapability -Online -Name $capability).State
if ($state -eq 'InstallPending') {
  throw 'OpenSSH Server is waiting for a restart. Restart Windows, then run chezmoi apply again'
}
if ($state -ne 'Installed') {
  $result = Add-WindowsCapability -Online -Name $capability
  if ($result.RestartNeeded) {
    throw 'OpenSSH Server installed. Restart Windows, then run chezmoi apply again to finish the setup'
  }
}

Set-Service -Name sshd -StartupType Automatic
if ((Get-Service sshd).Status -ne 'Running') {
  Start-Service sshd
}

if (-not (Get-NetFirewallRule -Name 'OpenSSH-Server-In-TCP' -ErrorAction SilentlyContinue)) {
  New-NetFirewallRule -Name 'OpenSSH-Server-In-TCP' -DisplayName 'OpenSSH Server (sshd)' -Enabled True -Direction Inbound -Protocol TCP -Action Allow -LocalPort 22 | Out-Null
}

# SSH sessions open in Windows PowerShell instead of cmd. Takes effect on the next login.
$shell = Join-Path $env:SystemRoot 'System32\WindowsPowerShell\v1.0\powershell.exe'
New-Item -Path 'HKLM:\SOFTWARE\OpenSSH' -Force | Out-Null
New-ItemProperty -Path 'HKLM:\SOFTWARE\OpenSSH' -Name DefaultShell -Value $shell -PropertyType String -Force | Out-Null

$key = '{{ $key | trim | replace "'" "''" }}'
if (-not $key) {
  Write-Warning 'No ssh_public_key set, skipping authorized_keys. Run chezmoi init to enter one'
  return
}

$file = Join-Path $env:ProgramData 'ssh\administrators_authorized_keys'
if (-not (Test-Path $file)) {
  New-Item -Path $file -ItemType File -Force | Out-Null
}
if (-not (Select-String -Path $file -SimpleMatch $key -Quiet)) {
  Add-Content -Path $file -Value $key -Encoding ascii
}
# SIDs for SYSTEM and Administrators, so this works on any Windows language
icacls $file /inheritance:r /grant '*S-1-5-18:(F)' '*S-1-5-32-544:(F)' | Out-Null
if ($LASTEXITCODE -ne 0) { throw "icacls failed with exit code $LASTEXITCODE" }
Write-Host "SSH server running, key authorized in $file"
{{- end }}
