{{- if eq .chezmoi.os "windows" -}}
{{- $ids := .packages.winget -}}
{{- if ne (env "CI") "true" -}}
{{-   $ids = concat $ids .packages.winget_desktop -}}
{{-   if and (hasKey . "server") .server -}}
{{-     $ids = concat $ids .packages.winget_server -}}
{{-   end -}}
{{- end -}}
# winget packages hash: {{ $ids | toJson | sha256sum }}
$ErrorActionPreference = 'Stop'

$ids = @('{{ $ids | join "','" }}')

# keep going after a failed install, so one bad installer doesn't skip the rest
$failed = @()
foreach ($id in $ids) {
  winget list --id $id --exact --source winget --accept-source-agreements | Out-Null
  if ($LASTEXITCODE -eq 0) {
    Write-Host "$id already installed"
    continue
  }

  Write-Host "Installing $id"
  winget install --id $id --exact --source winget --silent --accept-package-agreements --accept-source-agreements
  if ($LASTEXITCODE -ne 0) {
    Write-Warning "winget install failed for $id (exit code $LASTEXITCODE)"
    $failed += $id
  }
}

if ($failed.Count -gt 0) {
  throw "winget install failed for: $($failed -join ', ')"
}
{{- end }}
