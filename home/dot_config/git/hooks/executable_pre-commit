#!/usr/bin/env bash
# Scans the staged changes for secrets before every commit, in every repo, because
# core.hooksPath points here. Skip it for one commit with git commit --no-verify.
set -euo pipefail

trufflehog_bin="$(command -v trufflehog 2> /dev/null || true)"
# on Windows, ~/.local/bin isn't on the PATH Git's bash sees, and the dotfiles install it there
case "$(uname -s)" in
  MINGW* | MSYS*)
    if [ -z "$trufflehog_bin" ] && [ -f "$HOME/.local/bin/trufflehog.exe" ]; then
      trufflehog_bin="$HOME/.local/bin/trufflehog.exe"
    fi
    ;;
esac
if [ -z "$trufflehog_bin" ]; then
  echo "pre-commit: trufflehog is not installed, so the staged changes can't be scanned." >&2
  echo "Install it by running chezmoi apply. To commit without a scan: git commit --no-verify" >&2
  exit 1
fi

if git diff --cached --quiet; then
  exit 0
fi

# scan the staged version of each file, not the working tree copy
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
git diff --cached --name-only --diff-filter=ACMR -z | while IFS= read -r -d '' file; do
  mkdir -p "$tmp/$(dirname "$file")"
  git show ":$file" > "$tmp/$file"
done

# same results CI fails on
"$trufflehog_bin" filesystem "$tmp" --no-update --results=verified,unknown --fail
