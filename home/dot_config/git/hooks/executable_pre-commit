#!/usr/bin/env bash
# Scans the staged changes for secrets before every commit, in every repo, because
# core.hooksPath points here. Skip it for one commit with git commit --no-verify.
set -euo pipefail

if ! command -v trufflehog > /dev/null 2>&1; then
  echo "pre-commit: trufflehog is not installed, so the staged changes can't be scanned." >&2
  echo "Install it with: mise install trufflehog. To commit without a scan: git commit --no-verify" >&2
  exit 1
fi

if git diff --cached --quiet; then
  exit 0
fi

# scan the staged version of each file, not the working tree copy
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
git diff --cached --name-only --diff-filter=ACMR -z | while IFS= read -r -d '' file; do
  mkdir -p "$tmp/$(dirname "$file")"
  git show ":$file" > "$tmp/$file"
done

# same results CI fails on
trufflehog filesystem "$tmp" --no-update --results=verified,unknown --fail
