{{- if eq .chezmoi.os "windows" -}}
#Requires -RunAsAdministrator
$ErrorActionPreference = 'Stop'

# Multiplane Overlay presentation stalls freeze every Chrome window when several video
# streams are open. Seen on NVIDIA GPUs and on an Intel and NVIDIA laptop, so it runs on every
# machine. OverlayTestMode = 5 turns MPO off (restart required).
$dwm = 'HKLM:\SOFTWARE\Microsoft\Windows\Dwm'
if (-not (Test-Path $dwm)) { New-Item -Path $dwm | Out-Null }
Set-ItemProperty -Path $dwm -Name 'OverlayTestMode' -Value 5 -Type DWord
Write-Host 'Disabled Multiplane Overlay (restart required)'
{{- end }}
